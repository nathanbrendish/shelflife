# ShelfLife environment variables.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `.env*` is gitignored (see .gitignore).

# --- Supabase (public — safe to expose to the browser) ---
# From your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google Gemini (server-only — MUST NOT be prefixed NEXT_PUBLIC_) ---
# Used by receipt scanning, meal suggestions, and the meal planner.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Overrides the default model. Verify the value is a currently
# supported model before setting in production.
# GEMINI_MODEL=gemini-3.5-flash

# --- Site URL ---
# Used for auth email redirect links (emailRedirectTo). In production set to
# the live origin, e.g. https://myshelflife.co.uk. Locally, leave unset to
# fall back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
