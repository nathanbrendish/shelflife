# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated document exports - the tracked .md sources under docs/ (and
# CONTRIBUTING.md at the repo root) are the source of truth; PDF/DOCX copies
# are local, generated convenience exports and are not version-controlled.
docs/**/*.pdf
docs/**/*.docx
CONTRIBUTING.pdf
